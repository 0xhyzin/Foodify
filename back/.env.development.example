# Copy to .env.development. Generate secrets before starting the API.
# JWT_SECRET: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# EMAIL_ENCRYPTION_KEY: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD: generate separate secrets.token_hex(32).
APP_ENV=development
APP_NAME="Foodify API"
DEBUG=false
DOCS_ENABLED=true
HOST=127.0.0.1
PORT=8000
WORKERS=1
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DATABASE_URL=mysql+pymysql://foodify:REPLACE_WITH_RANDOM_HEX@127.0.0.1:3306/foodify?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_BYTES
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
JWT_ISSUER=foodify-api
JWT_AUDIENCE=foodify-client
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=15
OAUTH_STATE_MINUTES=10
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Use one host consistently for frontend and API. Cross-site cookies require HTTPS + none.
BROWSER_COOKIE_SAME_SITE=lax
TRUSTED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_PROXY_IPS=[]
MAX_REQUEST_BYTES=1048576
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@foodify.example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Keep all three values absent to disable each OAuth provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/facebook/callback
OAUTH_FACEBOOK_GRAPH_VERSION=v26.0

# Development/test only. Production checkout requires a real payment adapter.
ALLOW_SIMULATED_PAYMENTS=true

# Sprint 2 checkout: see .env.payments.example for Paymob and InstaPay settings.
ALLOW_CASH_ON_DELIVERY=true
PAYMOB_LIVE=false
