# FastAPI Cloud Hobby + Aiven MySQL/Valkey + Mailjet SMTP.
# Add these values in the FastAPI Cloud app's Environment Variables; never commit real values.
APP_ENV=production
DEBUG=false
DOCS_ENABLED=false

# Use a dedicated, least-privilege Aiven MySQL app user.
DATABASE_URL=mysql+pymysql://foodify:REPLACE_WITH_APP_PASSWORD@YOUR_AIVEN_MYSQL_HOST:YOUR_PORT/defaultdb?charset=utf8mb4
# Optional: use only when running a schema migration; remove from runtime after setup.
MIGRATION_DATABASE_URL=mysql+pymysql://foodify_migrator:REPLACE_WITH_MIGRATION_PASSWORD@YOUR_AIVEN_MYSQL_HOST:YOUR_PORT/defaultdb?charset=utf8mb4
DATABASE_TLS_REQUIRED=true
DATABASE_SSL_CA_PEM=REPLACE_WITH_AIVEN_CA_CERTIFICATE
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1

# Aiven Valkey's TLS URL (rediss://).
REDIS_URL=rediss://default:REPLACE_WITH_VALKEY_PASSWORD@YOUR_AIVEN_VALKEY_HOST:YOUR_PORT/0

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
FRONTEND_PROXY_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ISSUER=foodify-api-production
JWT_AUDIENCE=foodify-client-production

# Replace with the domain assigned to the deployed API.
PUBLIC_BASE_URL=https://YOUR_API.fastapicloud.dev
FRONTEND_URL=https://foodify-flax.vercel.app
CORS_ORIGINS=["https://foodify-flax.vercel.app"]
TRUSTED_HOSTS=["YOUR_API.fastapicloud.dev"]
BROWSER_COOKIE_SAME_SITE=lax

# Mailjet SMTP relay; use the API Key/Secret Key pair and a verified sender.
EMAIL_PROVIDER=smtp
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_MAILJET_API_KEY
SMTP_PASSWORD=YOUR_MAILJET_SECRET_KEY
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=YOUR_VERIFIED_SENDER@example.com
EMBEDDED_EMAIL_WORKER=true

# Optional: set all three values for each OAuth provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://YOUR_API.fastapicloud.dev/api/v1/auth/oauth/google/callback
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=https://YOUR_API.fastapicloud.dev/api/v1/auth/oauth/facebook/callback

# Development/test only. Production checkout requires a real payment adapter.
ALLOW_SIMULATED_PAYMENTS=false

# Sprint 2 checkout: see .env.payments.example for Paymob and InstaPay settings.
ALLOW_CASH_ON_DELIVERY=true
PAYMOB_LIVE=false
