# Isolated QA environment. This file does not run or create tests.
# Copy to .env.test, generate independent secrets and provision a separate MySQL database.
APP_ENV=test
DEBUG=false
DOCS_ENABLED=true
HOST=127.0.0.1
PORT=8001
WORKERS=1
DATABASE_URL=mysql+pymysql://foodify_qa:REPLACE_WITH_RANDOM_HEX@127.0.0.1:3306/foodify_test?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/1
JWT_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_TOKEN_AT_LEAST_32_BYTES
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_AN_INDEPENDENT_FERNET_KEY
JWT_ISSUER=foodify-api-test
JWT_AUDIENCE=foodify-client-test
PUBLIC_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
BROWSER_COOKIE_SAME_SITE=lax
TRUSTED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_PROXY_IPS=[]
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@foodify.example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
OAUTH_FACEBOOK_GRAPH_VERSION=v26.0
