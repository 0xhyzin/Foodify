# Copy the settings you need into .env.development / .env.test / .env.production.
# Never copy provider secrets into front/.env or a VITE_* variable.
ALLOW_CASH_ON_DELIVERY=true
PAYMOB_LIVE=false
# PAYMOB_SECRET_KEY=your_egy_sk_test_secret_key
# PAYMOB_PUBLIC_KEY=your_egy_pk_test_public_key
# PAYMOB_HMAC_SECRET=your_dashboard_hmac_secret
# PAYMOB_CARD_INTEGRATION_ID=12345
# PAYMOB_WALLET_INTEGRATION_ID=67890
# INSTAPAY_RECIPIENT=your_verified_payment_address@bank
# INSTAPAY_RECIPIENT_NAME=Your verified account holder
# Production also needs HTTPS PUBLIC_BASE_URL and FRONTEND_URL.
# Use live keys and live integration IDs together with PAYMOB_LIVE=true.
