# Copy to .env.production on the deployment host, or inject these environment variables.
# Use distinct generated credentials; never commit the real file.
# For the free Render + Aiven + Brevo setup, use .env.free.example instead.
APP_ENV=production
DEBUG=false
DOCS_ENABLED=false
HOST=0.0.0.0
PORT=8000
WORKERS=1
# Runtime login has DML permissions only. URL-encode passwords in explicit URLs.
DATABASE_URL=mysql+pymysql://foodify:REPLACE_WITH_RANDOM_HEX@mysql.internal:3306/foodify?charset=utf8mb4
# Optional separate login for schema changes; put it on the API release service only.
MIGRATION_DATABASE_URL=mysql+pymysql://foodify_migrator:REPLACE_WITH_MIGRATION_PASSWORD@mysql.internal:3306/foodify?charset=utf8mb4
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
REDIS_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@redis.internal:6379/0
JWT_SECRET=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_BYTES
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
JWT_ISSUER=foodify-api-production
JWT_AUDIENCE=foodify-client-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=15
PUBLIC_BASE_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=["https://your-domain.com"]
# For a separate cross-site HTTPS frontend use none; keep same-site deployments on lax.
BROWSER_COOKIE_SAME_SITE=lax
TRUSTED_HOSTS=["api.your-domain.com"]
# Set only to the real reverse proxy IPs/CIDR ranges. Never use a wildcard or /0.
TRUSTED_PROXY_IPS=[]
# Same random secret on Vercel and FastAPI; signs the client IP for rate limiting.
FRONTEND_PROXY_SECRET=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_BYTES
MAX_REQUEST_BYTES=1048576
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Optional: configure all three settings for each enabled provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/oauth/google/callback
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/oauth/facebook/callback
OAUTH_FACEBOOK_GRAPH_VERSION=v26.0
