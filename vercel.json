{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix front ci",
  "buildCommand": "npm run build",
  "outputDirectory": "front/dist",
  "functions": { "api/proxy.mjs": { "maxDuration": 90 } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/proxy?foodify_path=:path*" },
    { "source": "/verify-email", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/oauth/callback", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'" }
      ]
    }
  ]
}
