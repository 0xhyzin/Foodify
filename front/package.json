{
  "name": "foodify-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:test": "vite --mode test --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:production": "tsc -b && vite build --mode production",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
